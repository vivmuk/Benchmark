      "raw_response": "Here's a complete, self-contained dashboard card. Everything is inline — no external images, fonts, or libraries. The sparkline is generated by JS as inline SVG, the ring is animated CSS/SVG, and the **Start Focus** button runs a working 25‑minute session timer that takes over the ring.\n\n```html\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>Focus Dashboard — Daily Score</title>\n<style>\n  :root{\n    --bg-0:#07090f;\n    --bg-1:#0d1119;\n    --card-a:#161b27;\n    --card-b:#0f131c;\n    --panel:rgba(255,255,255,.035);\n    --line:rgba(255,255,255,.075);\n    --txt:#e8ecf4;\n    --txt-dim:#98a2b8;\n    --txt-faint:#616b80;\n    --a1:#8b5cf6;\n    --a2:#22d3ee;\n    --good:#34d399;\n    --bad:#f87171;\n    --warn:#fbbf24;\n    --r:20px;\n  }\n\n  *{box-sizing:border-box;margin:0;padding:0}\n\n  html,body{height:100%}\n\n  body{\n    font-family:\"Inter\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n    background:\n      radial-gradient(900px 500px at 12% -10%, rgba(139,92,246,.16), transparent 60%),\n      radial-gradient(800px 500px at 100% 110%, rgba(34,211,238,.12), transparent 60%),\n      linear-gradient(180deg,var(--bg-1),var(--bg-0));\n    color:var(--txt);\n    display:grid;\n    place-items:center;\n    padding:28px 16px;\n    -webkit-font-smoothing:antialiased;\n  }\n\n  /* ---------- card ---------- */\n  .card{\n    width:min(430px,100%);\n    background:linear-gradient(180deg,var(--card-a),var(--card-b));\n    border:1px solid var(--line);\n    border-radius:var(--r);\n    padding:20px;\n    box-shadow:\n      0 1px 0 rgba(255,255,255,.06) inset,\n      0 30px 70px -28px rgba(0,0,0,.9),\n      0 0 0 1px rgba(0,0,0,.4);\n    position:relative;\n    overflow:hidden;\n  }\n  .card::before{\n    content:\"\";\n    position:absolute;inset:-1px -1px auto -1px;height:110px;\n    background:radial-gradient(60% 100% at 50% 0%, rgba(139,92,246,.20), transparent 70%);\n    pointer-events:none;\n  }\n\n  /* ---------- header ---------- */\n  .head{display:flex;align-items:center;gap:12px;position:relative}\n  .avatar{\n    width:40px;height:40px;border-radius:12px;flex:0 0 auto;\n    background:conic-gradient(from 200deg,var(--a1),var(--a2),#f472b6,var(--a1));\n    display:grid;place-items:center;font-size:14px;font-weight:700;letter-spacing:.5px;\n    color:#0b0e14;box-shadow:0 6px 18px -6px rgba(139,92,246,.7);\n  }\n  .who{flex:1;min-width:0}\n  .who h1{font-size:15px;font-weight:600;letter-spacing:-.01em}\n  .who p{font-size:12px;color:var(--txt-faint);margin-top:2px}\n  .badge{\n    font-size:11px;font-weight:600;color:var(--warn);\n    background:rgba(251,191,36,.1);border:1px solid rgba(251,191,36,.22);\n    padding:5px 9px;border-radius:999px;white-space:nowrap;\n  }\n\n  /* ---------- ring + stats ---------- */\n  .body{display:flex;gap:18px;align-items:center;margin:22px 2px 18px}\n\n  .ringwrap{position:relative;width:132px;height:132px;flex:0 0 auto}\n  .ringwrap svg{width:100%;height:100%;transform:rotate(-90deg)}\n  .track{fill:none;stroke:rgba(255,255,255,.06);stroke-width:10}\n  .prog{\n    fill:none;stroke:url(#grad);stroke-width:10;stroke-linecap:round;\n    stroke-dasharray:339.29;stroke-dashoffset:339.29;\n    transition:stroke-dashoffset 1.3s cubic-bezier(.22,1,.36,1);\n    filter:drop-shadow(0 0 6px rgba(139,92,246,.55));\n  }\n  .sesstrack{fill:none;stroke:rgba(255,255,255,.05);stroke-width:4;opacity:0;transition:opacity .35s}\n  .sess{\n    fill:none;stroke:var(--good);stroke-width:4;stroke-linecap:round;\n    stroke-dasharray:282.74;stroke-dashoffset:282.74;\n    opacity:0;transition:opacity .35s, stroke-dashoffset .9s linear;\n    filter:drop-shadow(0 0 5px rgba(52,211,153,.6));\n  }\n  .card.running .sess,.card.running .sesstrack{opacity:1}\n\n  .center{position:absolute;inset:0;display:grid;place-items:center;text-align:center}\n  .view{transition:opacity .28s, transform .28s;position:absolute}\n  .view.hide{opacity:0;transform:scale(.9);pointer-events:none}\n  .score{font-size:40px;font-weight:700;letter-spacing:-.03em;line-height:1;\n         background:linear-gradient(180deg,#fff,#b8c0d4);-webkit-background-clip:text;background-clip:text;color:transparent}\n  .score span{font-size:15px;color:var(--txt-faint);-webkit-text-fill-color:var(--txt-faint);margin-left:2px}\n  .caplbl{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--txt-faint);margin-top:6px}\n  .clock{font-size:31px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums;color:#fff}\n\n  .stats{flex:1;display:grid;gap:9px;min-width:0}\n  .stat{\n    display:flex;align-items:center;justify-content:space-between;gap:8px;\n    background:var(--panel);border:1px solid var(--line);\n    border-radius:11px;padding:9px 11px;\n  }\n  .stat b{font-size:13.5px;font-weight:600;font-variant-numeric:tabular-nums}\n  .stat i{font-style:normal;font-size:11.5px;color:var(--txt-faint)}\n  .dot{width:6px;height:6px;border-radius:50%;flex:0 0 auto}\n\n  /* ---------- sparkline ---------- */\n  .chart{\n    background:var(--panel);border:1px solid var(--line);\n    border-radius:14px;padding:13px 13px 9px;position:relative;\n  }\n  .chart-top{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px}\n  .chart-top h2{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--txt-faint);font-weight:600}\n  .delta{font-size:12px;font-weight:600;display:flex;align-items:center;gap:4px}\n  .delta.up{color:var(--good)} .delta.down{color:var(--bad)}\n  .delta em{font-style:normal;color:var(--txt-faint);font-weight:500}\n\n  .plot{position:relative;height:62px;cursor:crosshair}\n  .plot svg{width:100%;height:100%;display:block;overflow:visible}\n  .spark{fill:none;stroke:url(#lgrad);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;\n         vector-effect:non-scaling